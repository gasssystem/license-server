# Copie para .env e preencha. .env NÃO é versionado.

# Porta HTTP do serviço
PORT=8090

# --- MySQL (TurboCloud) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=docflow_lic
DB_PASSWORD=troque-aqui
DB_NAME=docflow_licencas
# defina como "true" se o MySQL da TurboCloud exigir conexão TLS
DB_SSL=false

# --- Sessão da área de gerenciamento ---
# Segredo para assinar os tokens de login. Gere algo longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Origens permitidas a chamar a API (CORS), separadas por vírgula.
# Use "*" para liberar geral (a rota de validação é pública mesmo).
CORS_ORIGINS=*

# Dias antes da expiração em que o app começa a exibir aviso de renovação
AVISO_ANTECEDENCIA_DIAS=15

# --- Usado só pelo "npm run criar-usuario" (opcional) ---
# SEED_NOME=Sergio Lacerda
# SEED_EMAIL=sergio.lacerda@gasssystem.com.br
# SEED_SENHA=
